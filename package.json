{
  "name": "dsh-boot-animation-pro",
  "version": "1.0.0",
  "description": "DSH 片头开机动画（增强版）：铺满窗口播放视频片头，带播放控制、触发规则、会话名单、分时段片头、片库管理和中英双语界面。A full-frame intro animation for DSH with playback controls, trigger rules, session lists, time-based clips, library management and a bilingual UI.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "ARCHITECTURE.md",
    "FORK.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "author": "Yiheng-guo",
  "contributors": [
    "NativeDog1 (original dsh-boot-animation)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yiheng-guo/dsh-boot-animation-pro.git"
  },
  "homepage": "https://github.com/Yiheng-guo/dsh-boot-animation-pro#readme",
  "bugs": {
    "url": "https://github.com/Yiheng-guo/dsh-boot-animation-pro/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "boot-animation",
    "intro",
    "splash",
    "startup",
    "theme"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "node scripts/check-css-template.mjs && tsdown",
    "embed-clips": "node scripts/embed-clips.mjs",
    "dsh:link": "node scripts/dsh-link.mjs",
    "dsh:unlink": "node scripts/dsh-link.mjs --remove",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run verify:build && npm run verify:settings && npm run verify:schedule && npm run verify:trigger && npm run verify:i18n && npm run verify:library-ops && npm run verify:route-guard && npm run verify:routes && npm run verify:selection && npm run verify:cache && npm run verify:blank && npm run verify:boot && npm run verify:preview && npm run verify:playback && npm run verify:random && npm run verify:fallback && npm run verify:install && npm run verify:teardown && npm run verify:version-refresh && npm run verify:session-id",
    "verify:build": "node scripts/check-css-template.mjs && node scripts/verify-build.mjs",
    "verify:settings": "node scripts/verify-settings.mjs",
    "verify:schedule": "node scripts/verify-schedule.mjs",
    "verify:trigger": "node scripts/verify-trigger.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:library-ops": "node scripts/verify-library-ops.mjs",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:selection": "node scripts/verify-selection.mjs",
    "verify:preview": "node scripts/verify-preview.mjs",
    "verify:playback": "node scripts/verify-playback.mjs",
    "verify:random": "node scripts/verify-random.mjs",
    "verify:cache": "node scripts/verify-cache.mjs",
    "verify:fallback": "node scripts/verify-fallback.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "verify:blank": "node scripts/verify-blank.mjs",
    "verify:boot": "node scripts/verify-client-boot.mjs",
    "verify:letterbox": "node scripts/verify-letterbox.mjs",
    "verify:teardown": "node scripts/verify-teardown.mjs",
    "verify:version-refresh": "node scripts/verify-version-refresh.mjs",
    "verify:session-id": "node scripts/verify-session-id.mjs",
    "verify:pin": "node scripts/verify-pin.mjs",
    "verify:gui": "node scripts/verify-boot-animation.mjs",
    "verify:route-guard": "node scripts/verify-route-guard.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  }
}
